# ==========================================
# Configurazione Bot Telegram DMI(F-N)
# ==========================================

# Inserisci qui il token fornito da @BotFather su Telegram
TELEGRAM_BOT_TOKEN=IL_TUO_TOKEN_TELEGRAM_QUI

# Intervallo in secondi per il controllo periodico dei nuovi avvisi (default: 600 secondi = 10 minuti)
CHECK_INTERVAL_SECONDS=600

# Numero di pagine del sito DMI da scansionare ad ogni controllo (default: 2)
SCAN_MAX_PAGES=2

# Percorso database SQLite (default: dmi_bot.db)
DB_PATH=dmi_bot.db
